use history-common.nu *

def merge-text [git: string, before: string, after: string, destination: string] {
    let temporary = (mktemp --directory --tmpdir restack-check.XXXXXXXX)
    let result = (try {
        $before | decode base64 | save --raw ($temporary | path join base)
        $after | decode base64 | save --raw ($temporary | path join source)
        $destination | decode base64 | save --raw ($temporary | path join destination)
        do {
            run-external ...[$git merge-file --stdout --diff3 --diff-algorithm myers
                ($temporary | path join destination) ($temporary | path join base) ($temporary | path join source)]
        } | complete
    } catch {
        {exit_code: 255, stdout: "", stderr: "merge command unavailable"}
    })
    # This path is generated by mktemp, never derived from repository filenames.
    rm --recursive --force $temporary
    if $result.exit_code == 0 {
        {status: clean, content: ($result.stdout | encode base64), reason: "three-way text merge"}
    } else if $result.exit_code > 0 and $result.exit_code < 128 {
        {status: conflict, content: null, reason: "three-way text conflict"}
    } else {
        {status: unknown, content: null, reason: "git merge-file failed or is unavailable"}
    }
}

def apply-entry [entry: record, destination: record, git: string] {
    let before = $entry.before
    let after = $entry.after
    if $entry.status in [copied renamed] {
        return {status: unknown, content: null, reason: "rename/copy requires explicit destination mapping"}
    }
    for file in [$before $after $destination] {
        if ($file | get -o issue) != null {
            return {status: unknown, content: null, reason: $file.issue}
        }
        if $file.kind not-in [file absent] {
            return {status: unknown, content: null, reason: $"unsupported file kind: ($file.kind)"}
        }
        if $file.kind == file and ($file.content | decode base64 | bytes index-of 0x[00]) >= 0 {
            return {status: unknown, content: null, reason: "binary content"}
        }
    }
    if $after.kind == absent {
        if $destination.kind == absent or ($destination.content == $before.content and $destination.executable == $before.executable) {
            return {status: clean, content: null, reason: "delete unchanged or already absent file"}
        }
        return {status: conflict, content: null, reason: "delete/modify conflict"}
    }
    if $before.kind == absent {
        if $destination.kind == absent or ($destination.content == $after.content and $destination.executable == $after.executable) {
            return {status: clean, content: $after.content, reason: "add new or identical file"}
        }
        return {status: conflict, content: null, reason: "add/add conflict"}
    }
    if $destination.kind == absent {
        return {status: conflict, content: null, reason: "modify/delete conflict"}
    }
    if $destination.content == $before.content or $destination.content == $after.content {
        return {status: clean, content: $after.content, reason: "apply to unchanged or already matching content"}
    }
    if $before.content == $after.content {
        return {status: clean, content: $destination.content, reason: "metadata-only change"}
    }
    merge-text $git $before.content $after.content $destination.content
}

# Predict application conflicts without creating jj changes or touching the worktree.
def main [
    --change: string # Single source change; pair with --onto
    --onto: string # Destination revision for a single-change check
    --base: string # Original excluded ancestor; required with --tip and --order
    --tip: string # Original included tip
    --order: path # JSON array: a permutation of the source revisions in BASE..TIP
    --repository: string = "."
    --jj: string = "jj"
    --git: string = "git" # git merge-file is a prediction backend, not jj's merger
    --python: string = "python3" # Needed only for dependency checks in --order mode
    --max-commits: int = 500
    --max-file-bytes: int = 1048576
    --json
] {
    let single = ($change != null and $onto != null and $base == null and $tip == null and $order == null)
    let ordered = ($change == null and $onto == null and $base != null and $tip != null and $order != null)
    if not ($single or $ordered) {
        error make {msg: "Use --change/--onto OR --base/--tip/--order"}
    }
    if $max_commits < 1 or $max_file_bytes < 1 {
        error make {msg: "Resource limits must be positive"}
    }
    let frozen = (session $repository $jj)
    let analysis = (if $single {
        {destination: (revision $frozen $onto), changes: [(delta $frozen (revision $frozen $change) $max_file_bytes)], dependencies: [], issues: []}
    } else {
        let scope = (stack $frozen $base $tip $max_commits)
        let requested = (open --raw $order | from json)
        if ($requested | describe) !~ '^list' {
            error make {msg: "--order must contain a JSON array of revision strings; split plans require explicit reconstruction"}
        }
        let planned = ($requested | each {|expr|
            if ($expr | describe) != string {
                error make {msg: "Every --order element must be a revision string"}
            }
            revision $frozen $expr
        })
        if ($planned | get id | sort) != ($scope.changes | get id | sort) {
            error make {msg: "--order must contain every source revision exactly once"}
        }
        let original = ($scope.changes | each {|rev| delta $frozen $rev $max_file_bytes})
        let evidence = (python-analysis $python {
            mode: dependencies, base: $scope.base.change, tip: $scope.tip.change,
            changes: $original, path: null, hunk: null
        })
        let positions = ($planned | enumerate | reduce --fold {} {|row, positions|
            $positions | insert $row.item.change $row.index
        })
        let missing = ($evidence.dependencies | where {|edge|
            ($positions | get $edge.prerequisite) > ($positions | get $edge.dependent)
        })
        {destination: $scope.base,
         changes: ($planned | each {|rev| $original | where id == $rev.id | first}),
         dependencies: $missing, issues: $evidence.issues}
    })
    mut state = (snapshot $frozen $analysis.destination)
    let existing_conflicts = ($state | where kind == conflict | get path)
    let source_conflicts = ($analysis.changes | each {|rev|
        $rev.conflicts | each {|name| {change: $rev.change, path: $name}}
    } | flatten)
    mut events = []
    mut assessed = []
    mut blocked = (not ($existing_conflicts | is-empty) or not ($source_conflicts | is-empty))
    for source in $analysis.changes {
        if $blocked { break }
        $assessed = ($assessed | append $source.change)
        for entry in $source.entries {
            let name = $entry.after.path
            let present = ($state | where path == $name)
            let destination = (if ($present | is-empty) { absent $name } else {
                let file = ($present | first)
                if 'content' in $file { $file } else { file-content $frozen $analysis.destination.id $file $max_file_bytes }
            })
            let result = (apply-entry $entry $destination $git)
            $events = ($events | append {
                change: $source.change, description: $source.description,
                path: $name, source_path: $entry.before.path,
                status: $result.status, reason: $result.reason
            })
            if $result.status != clean {
                $blocked = true
                continue
            }
            # A changed executable flag applies to the destination; otherwise retain its flag.
            let executable = (if $entry.before.executable != $entry.after.executable or $destination.kind == absent {
                $entry.after.executable
            } else { $destination.executable })
            $state = ($state | where path != $name)
            if $entry.after.kind != absent {
                $state = ($state | append {
                    path: $name, kind: file, executable: $executable,
                    content: $result.content, issue: null
                })
            }
        }
        if not $blocked {
            # Check the completed commit boundary, allowing legitimate file/directory swaps.
            for entry in ($source.entries | where after.kind != absent) {
                let name = $entry.after.path
                let collision = ($state | any {|file|
                    $file.path != $name and (($file.path | str starts-with $"($name)/") or ($name | str starts-with $"($file.path)/"))
                })
                if $collision {
                    $events = ($events | append {
                        change: $source.change, description: $source.description,
                        path: $name, source_path: $entry.before.path,
                        status: conflict, reason: "file/directory conflict"
                    })
                    $blocked = true
                }
            }
        }
    }
    let report = {
        schema_version: 1, mode: (if $single {"single"} else {"order"}), engine: "git merge-file --diff3",
        destination: $analysis.destination.change,
        status: (if ($events | any {|event| $event.status == conflict}) {"conflict"} else if $blocked {"unknown"} else {"clean"}),
        complete: (not $blocked and ($analysis.issues | is-empty)),
        events: $events, reordered_dependencies: $analysis.dependencies,
        issues: $analysis.issues, existing_conflicts: $existing_conflicts, source_conflicts: $source_conflicts,
        unassessed: ($analysis.changes | where {|rev| $rev.change not-in $assessed} | get change),
        limitations: [
            "Predictions use Git's text merger; jj or structural mergers can produce different results."
            "Clean application does not establish behavioral independence or semantic ownership."
            "Candidate dependencies need manual review, including dependencies without textual overlap."
            "Rename/copy and non-regular-file mappings require manual assessment."
        ]
    }
    if $json { $report | to json -r } else { $report }
}
